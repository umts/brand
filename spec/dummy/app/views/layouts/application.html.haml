!!!
%html
  %head
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = stylesheet_link_tag 'application.css', media: 'all'
    = javascript_include_tag 'application.js', type: :module
  %body.min-vh-100.d-flex.flex-column.flex-nowrap.align-items-stretch.bg-primary
    %header
      = render partial: 'umts/brand/university_header',
               locals: { university_trademarks: true,
                         parent_department_name: 'Facilities & Campus Services',
                         parent_department_link: 'https://www.umass.edu/facilities',
                         department_name: 'Transportation Services',
                         department_link: 'https://www.umass.edu/transportation' }
    %main.bg-body.flex-grow-1
      .container.my-3
        = yield
    %footer= render partial: 'umts/brand/university_footer', locals: { university_trademarks: true }
