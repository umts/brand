- nav_items = capture do
  - 3.times do |n|
    %li.nav-item= link_to "Link #{n}", '#', class: 'nav-link'
= render layout: 'umts/brand/tabbed', locals: { heading: 'umts-brand', nav_items:, nav_expand: 'sm' } do
  .card
    .card-header
      %i.fa-brands.fa-bootstrap
      Bootstrap
    .card-body
      .alert.alert-primary
        Primary alert
      .alert.alert-neutral
        Neutral alert
      .row.row-cols-1.row-cols-md-2.g-3
        .col
          .d-grid= button_tag 'Primary button', type: 'button', class: 'btn btn-primary'
        .col
          .d-grid= button_tag 'Neutral button', type: 'button', class: 'btn btn-neutral'
