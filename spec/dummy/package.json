{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown app/javascript/application.js --dir app/assets/builds --format esm --sourcemap",
    "build:css": "sass app/assets/stylesheets/application.scss:app/assets/builds/application.css --load-path=node_modules --pkg-importer=node --quiet-deps --silence-deprecation=import"
  },
  "dependencies": {
    "@fontsource-utils/scss": "*",
    "@fontsource/public-sans": "*",
    "@fortawesome/fontawesome-free": "*",
    "@umts/brand": "file:../..",
    "bootstrap": "*",
    "rolldown": "*",
    "run-pty": "*",
    "sass": "*",
    "tom-select": "*"
  },
  "allowScripts": {
    "@parcel/watcher": true
  }
}
