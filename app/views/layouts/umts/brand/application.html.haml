-# locals: (body: nil)
- UMTS::Brand.protect_university_trademarks!
!!!
%html{ lang: I18n.locale }
  %head
    %meta{ charset: 'UTF-8' }
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    %title
      - if content_for?(:title)
        = yield :title
        &bull;
      = t('application.name', default: [:'umts.brand.department.name'])
      &bull;
      = t('umts.brand.university.name.shortform')
    = csrf_meta_tags
    = csp_meta_tag
    = umts_brand_favicons
    = stylesheet_link_tag 'application.css', media: 'all'
    = javascript_include_tag 'application.js', type: :module, defer: true
  %body.min-vh-100.d-flex.flex-column.flex-nowrap.align-items-stretch{ class: body }
    - if content_for?(:header)
      %header= yield :header
    %main.bg-body.flex-grow-1
      .container.my-3
        = render partial: 'flash'
        = yield
    - if content_for?(:footer)
      %footer= yield :footer
