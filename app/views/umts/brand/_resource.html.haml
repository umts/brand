-# locals: (nav_expand: nil)
- collector = UMTS::Brand::Collector.new(self, :heading, :nav_items, :body)
- yield collector
%section
  .navbar.align-items-end.border-bottom.mb-3.pt-0{ class: ['navbar-expand', nav_expand].compact_blank.join('-') }
    %h1.me-3.mb-0= collector.heading
    - if collector.nav_items.present?
      = button_tag type: 'button',
                   class: 'navbar-toggler',
                   data: { 'bs-toggle': 'collapse', 'bs-target': '#resource-navbar-content' },
                   aria: { expanded: 'false', label: 'Toggle navigation' } do
        %i.navbar-toggler-icon
      #resource-navbar-content.collapse.navbar-collapse
        .nav.navbar-nav.ms-auto
          = collector.nav_items
  = collector.body
