-# locals: ()
- collector = UMTS::Brand::Collector.new(self, :heading, :nav_items, :body)
- yield collector
.card
  .card-header
    .navbar.navbar-expand.navbar-flush.flex-wrap.justify-content-between.align-items-center.gap-3
      %div= collector.heading
      - if collector.nav_items.present?
        .nav.navbar-nav.gap-3
          = collector.nav_items
  = collector.body
