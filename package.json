{
  "name": "@umts/brand",
  "version": "0.0.0-dev",
  "description": "Branding for rails apps.",
  "repository": {
    "url": "https://github.com/umts/brand"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./public-sans": {
      "sass": "./dist/public-sans.scss"
    }
  },
  "scripts": {
    "build:css": "sass spec/dummy/app/assets/stylesheets/application.scss:spec/dummy/app/assets/builds/application.css --load-path=node_modules --pkg-importer=node --quiet-deps --silence-deprecation=import",
    "docs": "vitepress dev docs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:css": "stylelint **/*.css **/*.scss"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "< 10",
    "oxfmt": "*",
    "oxlint": "*",
    "run-pty": "*",
    "sass": "*",
    "semantic-release": "*",
    "stylelint": "*",
    "stylelint-config-standard": "*",
    "stylelint-config-standard-scss": "*",
    "vitepress": "2.0.0-alpha.20"
  },
  "peerDependencies": {
    "@fontsource-utils/scss": "0.2.*",
    "@fontsource/public-sans": "5.*"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
