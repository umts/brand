{
  "name": "@umts/brand",
  "version": "0.0.0-dev",
  "description": "Branding for rails apps.",
  "repository": {
    "url": "https://github.com/umts/brand"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./bootstrap": {
      "sass": "./dist/bootstrap.scss"
    },
    "./datatables": {
      "sass": "./dist/datatables.scss"
    },
    "./fontawesome": {
      "sass": "./dist/fontawesome.scss"
    },
    "./public-sans": {
      "sass": "./dist/public-sans.scss"
    },
    "./tom-select": {
      "sass": "./dist/tom-select.scss"
    }
  },
  "scripts": {
    "docs": "vitepress dev docs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:css": "stylelint **/*.css **/*.scss"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "< 10",
    "oxfmt": "*",
    "oxlint": "*",
    "semantic-release": "*",
    "stylelint": "*",
    "stylelint-config-standard": "*",
    "stylelint-config-standard-scss": "*",
    "vitepress": "2.0.0-alpha.20"
  },
  "peerDependencies": {
    "@fontsource-utils/scss": "0.2.*",
    "@fontsource/public-sans": "5.*",
    "@fortawesome/fontawesome-free": "7.*",
    "bootstrap": "5.3.*",
    "datatables.net-bs5": "3.*",
    "tom-select": "2.*"
  },
  "peerDependenciesMeta": {
    "@fortawesome/fontawesome-free": {
      "optional": true
    },
    "datatables.net-bs5": {
      "optional": true
    },
    "tom-select": {
      "optional": true
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
